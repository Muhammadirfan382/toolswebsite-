{
  "name": "everyday-tools",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "build": "node node_modules/astro/bin/astro.mjs build",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "check": "node node_modules/astro/bin/astro.mjs check",
    "astro": "node node_modules/astro/bin/astro.mjs",
    "test:unit": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test": "npm run build && npm run test:e2e",
    "test:all": "npm run test:unit && npm run test",
    "audit": "node scripts/audit-dist.mjs",
    "check:bundles": "node scripts/check-bundles.mjs",
    "verify": "npm run check && npm run test:unit && npm run build && npm run audit && npm run check:bundles && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
