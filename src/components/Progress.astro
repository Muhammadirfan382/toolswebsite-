---
/** Progress bar for long tasks. Controlled with progressFor(el) from src/lib/progress.ts. */
interface Props {
  id?: string;
}
const { id = 'progress' } = Astro.props;
---

<div class="progress" id={id} data-progress hidden>
  <label class="p-label" for={`${id}-bar`} data-progress-label>Working…</label>
  <progress id={`${id}-bar`} max="100"></progress>
  <p class="visually-hidden" aria-live="polite" data-progress-live></p>
</div>

<script>
  import { initAllProgress } from '../lib/progress';
  initAllProgress();
</script>

<style>
  .progress {
    margin-top: var(--space-3);
  }
  .p-label {
    display: block;
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }
  progress {
    width: 100%;
    height: 12px;
    appearance: none;
    border: 0;
    border-radius: var(--radius);
    background: var(--surface-2);
    overflow: hidden;
    accent-color: var(--accent);
  }
  progress::-webkit-progress-bar {
    background: var(--surface-2);
  }
  progress::-webkit-progress-value {
    background: var(--accent);
    transition: width 0.2s;
  }
  progress::-moz-progress-bar {
    background: var(--accent);
  }
</style>
