---
/** Temporary box shown on tool pages until the tool is built (Prompts 3–7). */
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<div class="notice coming-soon" role="status">
  <p><strong>Coming in this build.</strong> The {tool.name} tool is being built and will appear here.</p>
  <p class="muted">{tool.description}</p>
</div>

<style>
  .coming-soon p:last-child {
    margin-bottom: 0;
  }
</style>
