---
/**
 * One ad slot. Renders nothing when ads are off or the slot is disabled in src/data/ads.ts.
 * The height is reserved in CSS before anything loads (CLS). In live mode the AdSense unit is
 * requested only when the slot nears the viewport (see src/lib/ads/runtime.ts).
 * Markup must match scripts/rehype-ad-slots.mjs, which inserts in-article slots.
 */
import { ADS_MODE, ADSENSE_PUB_ID, slotConfig, type PageType } from '../data/ads';

interface Props {
  page: PageType;
  slot: string;
}
const { page, slot } = Astro.props;
const c = slotConfig(page, slot);
const live = ADS_MODE === 'live';
---

{
  c && (
    <aside
      class:list={['ad-slot', { 'ad-slot--anchor': slot === 'footer-anchor', 'ad-slot--wait': c.afterResult }]}
      data-ad-slot={slot}
      data-ad-page={page}
      data-ad-mode={ADS_MODE}
      data-after-result={c.afterResult ? 'true' : undefined}
      data-min-width={c.minWidth}
      aria-label="Advertisement"
      style={`--ad-h-m:${c.height.mobile}px;--ad-h-d:${c.height.desktop}px`}
    >
      <span class="ad-label">Advertisement</span>
      {live ? (
        <ins
          class="adsbygoogle"
          data-ad-client={ADSENSE_PUB_ID}
          data-ad-slot={c.adUnit}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      ) : (
        <span class="ad-placeholder">
          {slot} · reserved {c.height.mobile}px phone / {c.height.desktop}px desktop
        </span>
      )}
    </aside>
  )
}
