---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { SITE } from '../data/site';
import { FEATURED_SLUGS, getTool, CATEGORIES } from '../data/tools';

const featured = FEATURED_SLUGS.map(getTool);
---

<BaseLayout
  title={`Page Not Found | ${SITE.brand}`}
  description="The page you were looking for does not exist. Try one of our free browser-based tools instead."
  noindex
>
  <div class="container">
    <h1 class="title">Page not found</h1>
    <p class="lead">
      This page does not exist or has moved. Check the address, or pick one of these tools.
    </p>

    <h2>Popular tools</h2>
    <ul class="tool-grid">
      {
        featured.map((tool) => (
          <li>
            <ToolCard tool={tool} />
          </li>
        ))
      }
    </ul>

    <h2>Browse by category</h2>
    <ul class="cats">
      {CATEGORIES.map((c) => <li><a href={c.path}>{c.name}</a></li>)}
      <li><a href="/">All tools</a></li>
    </ul>
  </div>
</BaseLayout>

<style>
  .title {
    margin-top: var(--space-5);
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }
  .cats a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
