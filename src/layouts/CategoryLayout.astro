---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolCard from '../components/ToolCard.astro';
import { getCategory, toolsIn, type CategoryId } from '../data/tools';

interface Props {
  categoryId: CategoryId;
  title: string;
  description: string;
  h1: string;
}

const { categoryId, title, description, h1 } = Astro.props;
const category = getCategory(categoryId);
const tools = toolsIn(categoryId);
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: category.name, path: category.path },
      ]}
    />
    <h1>{h1}</h1>
    <p class="lead">{category.blurb}</p>

    <ul class="tool-grid list">
      {
        tools.map((tool) => (
          <li>
            <ToolCard tool={tool} headingLevel="h2" />
          </li>
        ))
      }
    </ul>

    <section class="prose">
      <slot />
    </section>
  </div>
</BaseLayout>

<style>
  .list {
    margin-top: var(--space-4);
  }
</style>
