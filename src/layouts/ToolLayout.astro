---
/**
 * Shared shell for every tool page.
 * Order: Breadcrumbs → H1 → intro → PrivacyBadge → [tool UI] → ad (after-result) → HowToSteps →
 *        ad (below-howto) → content (in-content-1 inserted at ~40%) → FAQ → guides → RelatedTools.
 *        On screens ≥ 1200px an optional sticky sidebar ad sits beside the lower part, never the tool.
 * Text (title, description, H1, intro, steps, FAQs, article) comes from
 * src/content/tools/<slug>.md; any prop passed here overrides it.
 * JSON-LD: BreadcrumbList, SoftwareApplication, HowTo and FAQPage.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PrivacyBadge from '../components/PrivacyBadge.astro';
import AdSlot from '../components/AdSlot.astro';
import HowToSteps from '../components/HowToSteps.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import GuideCard from '../components/GuideCard.astro';
import { getVisibleGuides } from '../lib/guides';
import { SITE } from '../data/site';
import { slotConfig } from '../data/ads';
import { getCategory, toolPath, type Tool } from '../data/tools';
import { breadcrumbList, faqPage, howTo, softwareApplication, toJsonLd } from '../lib/schema';

interface Props {
  tool: Tool;
  title?: string;
  description?: string;
  h1?: string;
  intro?: string;
  howToSteps?: string[];
  faqs?: FaqItem[];
  /** Word used in the privacy badge: "files" (default), "your text", "numbers"… */
  privacySubject?: string;
}

const { tool, privacySubject = 'files' } = Astro.props;
const entry = await getEntry('tools', tool.slug);
if (!entry) throw new Error(`Missing content file: src/content/tools/${tool.slug}.md`);
const { Content } = await render(entry);
const data = entry.data;

const title = Astro.props.title ?? `${data.title} | ${SITE.brand}`;
const description = Astro.props.description ?? data.description;
const h1 = Astro.props.h1 ?? data.h1;
const intro = Astro.props.intro ?? data.intro;
const howToSteps = Astro.props.howToSteps ?? data.howToSteps;
const faqs = Astro.props.faqs ?? data.faqs;

const toolGuides = (await getVisibleGuides()).filter((g) => g.data.relatedTools.includes(tool.slug)).slice(0, 6);

const hasSidebar = Boolean(slotConfig('tool', 'sidebar-desktop'));

const site = Astro.site!;
const category = getCategory(tool.category);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: category.name, path: category.path },
  { name: tool.name, path: toolPath(tool.slug) },
];

const schemas = [
  breadcrumbList(crumbs, site),
  softwareApplication({ name: tool.name, description, url: new URL(toolPath(tool.slug), site).href }),
  ...(howToSteps.length ? [howTo(`How to use the ${tool.name} tool`, howToSteps)] : []),
  ...(faqs.length ? [faqPage(faqs)] : []),
];
---

<BaseLayout title={title} description={description} adsPage="tool">
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={toJsonLd(s)} />)}
    <slot name="head" />
  </Fragment>

  <div class="container">
    <Breadcrumbs items={crumbs} />
    <h1>{h1}</h1>
    <p class="lead intro">{intro}</p>
    <PrivacyBadge subject={privacySubject} />

    <section class="tool-area" aria-label={`${tool.name} tool`}>
      <slot />
    </section>

    <AdSlot page="tool" slot="after-result" />

    <div class:list={['lower', { 'has-sidebar': hasSidebar }]}>
      <div class="lower-main">
        <HowToSteps heading={`How to use the ${tool.name} tool`} steps={howToSteps} />

        <AdSlot page="tool" slot="below-howto" />

        <article class="prose tool-content">
          <Content />
        </article>

        <FAQ faqs={faqs} />

        {
          toolGuides.length > 0 && (
            <section class="tool-guides" aria-labelledby="tool-guides-h">
              <h2 id="tool-guides-h">Guides</h2>
              <ul class="tool-grid">
                {toolGuides.map((g) => (
                  <li>
                    <GuideCard guide={g} />
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
      {
        hasSidebar && (
          <div class="lower-aside">
            <AdSlot page="tool" slot="sidebar-desktop" />
          </div>
        )
      }
    </div>

    <RelatedTools slugs={tool.related} />
  </div>
  <AdSlot page="tool" slot="footer-anchor" />
</BaseLayout>

<style>
  .lower-aside {
    display: none;
  }
  @media (min-width: 1200px) {
    .lower.has-sidebar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--space-5);
      align-items: start;
    }
    .lower.has-sidebar .lower-aside {
      display: block;
      position: sticky;
      top: var(--space-3);
      padding-top: var(--space-5);
    }
  }
  .intro {
    margin-bottom: var(--space-2);
  }
  .tool-area {
    margin-block: var(--space-3) var(--space-5);
  }
  .tool-content :global(h2) {
    margin-top: var(--space-5);
  }
  /* Wide tables scroll inside their own box on small phones; the page never scrolls sideways. */
  .tool-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin-bottom: var(--space-3);
  }
  .tool-content :global(th),
  .tool-content :global(td) {
    white-space: nowrap;
  }
  @media (max-width: 30rem) {
    .tool-content :global(th),
    .tool-content :global(td) {
      padding: var(--space-1) var(--space-2);
      white-space: normal;
    }
  }
</style>
